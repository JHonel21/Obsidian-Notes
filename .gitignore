# Exclude Obsidian's internal workspace state (open tabs, window positions)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Exclude cache and system files
.DS_Store
Thumbs.db
*.tmp

# Exclude local plugin state if you sync plugins across devices with different screen sizes
.obsidian/plugins/*/data.json

# Optional: Exclude hotkey configurations if you use different devices/OS setups
# .obsidian/hotkeys.json
